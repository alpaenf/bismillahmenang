# AntiScam Environment Variables Configuration

# Set to 'true' to use client-side smart mock simulation, or 'false' to connect to live backend API
NEXT_PUBLIC_USE_MOCK=true

# External REST API URL for Scam Detection Backend
NEXT_PUBLIC_API_URL=https://api.antiscam.id

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
